---
import { YM_COUNTER_ID } from "@/consts";

const enabled = import.meta.env.PROD && YM_COUNTER_ID;
---

{enabled && (
  <script is:inline define:vars={{ counterId: YM_COUNTER_ID }}>
    window.__mostInitYM = function () {
      if (window.__mostYMReady) return;
      window.__mostYMReady = true;

      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j=0; j<document.scripts.length; j++){ if (document.scripts[j].src===r){ return; } }
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document, 'script', `https://mc.yandex.ru/metrika/tag.js?id=${counterId}`, 'ym');

      ym(counterId, 'init', {
        ssr: true,
        webvisor: true,
        clickmap: true,
        accurateTrackBounce: true,
        trackLinks: true,
        referrer: document.referrer,
        url: location.href,
      });

      ym(counterId, 'params', {
        theme: document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light',
      });
    };
  </script>
)}
